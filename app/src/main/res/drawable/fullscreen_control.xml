<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <selector android:exitFadeDuration="110">
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <solid android:color="#626273" />
                    <stroke android:width="2dp" android:color="@color/tv_focus_ring" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#26FFFFFF" />
                    <stroke android:width="1dp" android:color="#29FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
