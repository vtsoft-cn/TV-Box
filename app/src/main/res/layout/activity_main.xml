<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/live_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/live_backdrop"
    android:padding="@dimen/live_padding">

    <LinearLayout
        android:id="@+id/channel_panel"
        android:layout_width="@dimen/channel_panel_width"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/channel_panel"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/channels"
            android:textColor="@color/tv_text"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/channel_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/tv_muted"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="#24FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/channel_hint"
            android:textColor="@color/tv_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentEnd="true"
        android:layout_toEndOf="@id/channel_panel"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/playback_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/live_badge"
                    android:drawableStart="@drawable/live_dot"
                    android:drawablePadding="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.08"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/live_label"
                    android:textColor="@color/tv_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/playing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/select_channel"
                    android:textColor="@color/tv_text"
                    android:textSize="28sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/fullscreen_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/fullscreen_control"
                android:contentDescription="@string/fullscreen"
                android:nextFocusLeft="@id/browse_grid"
                android:scaleType="center"
                android:src="@drawable/ic_fullscreen" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/vlc_preview_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/preview_frame"
            android:defaultFocusHighlightEnabled="false"
            android:descendantFocusability="blocksDescendants"
            android:focusable="false"
            android:padding="@dimen/preview_inset"
            tools:targetApi="26">

            <TextView
                android:id="@+id/playback_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/preview_frame"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/select_channel"
                android:textColor="@color/tv_text"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/fullscreen_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/preview_frame"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launcher_foreground" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/fullscreen_hint"
                    android:textColor="@color/tv_text"
                    android:textSize="14sp"
                    android:translationY="-1dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</RelativeLayout>
